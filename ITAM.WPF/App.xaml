<Application x:Class="ITAM.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ITAM.WPF"
             xmlns:converters="clr-namespace:ITAM.WPF.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnExplicitShutdown"
            >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:CustomColorTheme BaseTheme="Light" 
                                 PrimaryColor="#007ACC" 
                                 SecondaryColor="#FF8C42" />
                <!--<materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Lime" />-->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary Source="/Resources/MainResource.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/Resources/DataTemplates/ViewTemplates.xaml"/>
                <ResourceDictionary Source="/Resources/Themes/AppTheme.xaml"/>
                <ResourceDictionary Source="/Resources/Themes/MenuTheme.xaml"/>
                <ResourceDictionary Source="/Resources/Themes/ToolbarTheme.xaml"/>
                <ResourceDictionary Source="/Resources/Themes/HeThongDMTheme.xaml"/>
                
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters dùng toàn cục -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
