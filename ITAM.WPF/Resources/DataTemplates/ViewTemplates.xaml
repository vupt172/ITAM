<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:ITAM.WPF.ViewModels"
    xmlns:catalogViewModels="clr-namespace:ITAM.WPF.ViewModels.Catalogs"
    xmlns:views="clr-namespace:ITAM.WPF.Views"
    xmlns:catalogViews="clr-namespace:ITAM.WPF.Views.Catalogs"
    >

    <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:HeThongDMViewModel}">
        <views:HeThongDMView />
    </DataTemplate>

    <!-- Quản Trị Người Dùng / Vai Trò / Tham Số Người Dùng -->
    <DataTemplate DataType="{x:Type viewModels:UserManagementViewModel}">
        <views:UserManagementView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:RoleManagementViewModel}">
        <views:RoleManagementView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type viewModels:ThamSoNguoiDungViewModel}">
        <views:ThamSoNguoiDungView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type catalogViewModels:DMTaiSanViewModel}">
        <catalogViews:DMTaiSanView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type catalogViewModels:LoaiTaiSanViewModel}">
        <catalogViews:LoaiTaiSanView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type catalogViewModels:NhaCungCapViewModel}">
        <catalogViews:NhaCungCapView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type catalogViewModels:PhongBanViewModel}">
        <catalogViews:PhongBanView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type catalogViewModels:ViTriTaiSanViewModel}">
        <catalogViews:ViTriTaiSanView />
    </DataTemplate>
</ResourceDictionary>