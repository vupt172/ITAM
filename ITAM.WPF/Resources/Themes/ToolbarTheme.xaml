<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    >

    <!-- ================= COLORS ================= -->
    <Color x:Key="ToolbarTrayBackgroundColor">#9CADC6</Color>
    <Color x:Key="ToolbarBackgroundColor">#CCD5F0</Color>
    <Color x:Key="ToolbarForegroundColor">#1E1E1E</Color>
    <Color x:Key="ToolbarHoverColor">#ECF4FF</Color>
    <Color x:Key="ToolbarActiveColor">#B9C7EC</Color>
    <Color x:Key="ToolbarDisabledColor">#A2A2A2</Color>
    <Color x:Key="ToolbarSeparatorColor">#A6B2D1</Color>

    <!-- ================= BRUSHES ================= -->
    <SolidColorBrush x:Key="ToolbarTrayBackgroundBrush" Color="{StaticResource ToolbarTrayBackgroundColor}" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="{StaticResource ToolbarBackgroundColor}" />
    <SolidColorBrush x:Key="ToolbarForegroundBrush" Color="{StaticResource ToolbarForegroundColor}" />
    <SolidColorBrush x:Key="ToolbarHoverBrush" Color="{StaticResource ToolbarHoverColor}" />
    <SolidColorBrush x:Key="ToolbarActiveBrush" Color="{StaticResource ToolbarActiveColor}" />
    <SolidColorBrush x:Key="ToolbarDisabledBrush" Color="{StaticResource ToolbarDisabledColor}" />
    <SolidColorBrush x:Key="ToolbarSeparatorBrush" Color="{StaticResource ToolbarSeparatorColor}" />

    <!-- ================= TOOLBAR ================= -->
    <LinearGradientBrush x:Key="ToolbarBorderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0.0" />
        <GradientStop Color="#A6B2D1" Offset="1.0" />
    </LinearGradientBrush>
    <Style TargetType="ToolBar">
        <Setter Property="Background" Value="{StaticResource ToolbarBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ToolbarForegroundBrush}" />
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0,1,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ToolbarBorderGradient}"/>

    </Style>

    <!-- ================= TOOLBAR TRAY ================= -->
    <Style TargetType="ToolBarTray">
        <Setter Property="Background" Value="{StaticResource ToolbarTrayBackgroundBrush}" />

    </Style>

    <!-- ================= SEPARATOR ================= -->
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource ToolbarSeparatorBrush}" />
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="Width" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>



    <!-- ================= BUTTON INSIDE TOOLBAR ================= -->
    <Style TargetType="Button" x:Key="ToolbarButtonStyle" >

        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ToolbarForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">

                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ToolbarHoverBrush}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ToolbarActiveBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ToolbarDisabledBrush}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="ToolbarTextStyle"
       TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="materialDesign:PackIcon" x:Key="ToolbarIconStyle">
        <Setter Property="Foreground" Value="DarkOrange"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>

        <Style.Triggers>
            <DataTrigger
                Binding="{Binding IsEnabled,
                                  RelativeSource={RelativeSource AncestorType=Button}}"
                Value="False">
                <Setter Property="Foreground" Value="Gray"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="materialDesign:PackIcon" x:Key="ToolbarAddIconStyle">
        <Setter Property="Foreground" Value="#047857"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>

        <Style.Triggers>
            <DataTrigger
                Binding="{Binding IsEnabled,
                                  RelativeSource={RelativeSource AncestorType=Button}}"
                Value="False">
                <Setter Property="Foreground" Value="Gray"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="materialDesign:PackIcon" x:Key="ToolbarDeleteIconStyle">
        <Setter Property="Foreground" Value="#C62828"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>

        <Style.Triggers>
            <DataTrigger
             Binding="{Binding IsEnabled,
                               RelativeSource={RelativeSource AncestorType=Button}}"
             Value="False">
                <Setter Property="Foreground" Value="Gray"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
    