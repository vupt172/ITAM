<UserControl x:Class="ITAM.WPF.UserControls.MenuBarUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ITAM.WPF.UserControls"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             d:DesignWidth="800">
    <Grid Background="{StaticResource MenuBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Logo -->
        <StackPanel Grid.Column="0"  Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="/Assets/Images/logoITAM.png"
               Width="80"/>

        </StackPanel>
        <Menu Grid.Column="1">
            <!-- DASHBOARD -->
            <MenuItem Header="Dashboard">
                <MenuItem Header="View Dashboard"  Icon="{materialDesign:PackIcon Kind=ViewDashboard}" 
                          Command="{Binding NavigateDashboardCommand}" />
            </MenuItem>

            <!-- DANH MỤC -->
            <MenuItem Header="Danh Mục">
                <MenuItem  Header="Hệ Thống Danh Mục" Icon="{materialDesign:PackIcon Kind=FormatListBulleted}"
                           Command="{Binding NavigatHeThongDMCommand}"/>
            </MenuItem>
            <!-- TÀI SẢN -->
            <MenuItem Header="Quản Lý Tài Sản">
                <MenuItem Header="Nhập Tài Sản Từ NCC"/>
                <MenuItem Header="Danh Sách Tài Sản"/>
                <MenuItem Header="Điều Chuyển Tài Sản" Icon="{materialDesign:PackIcon Kind=SwapHorizontal}"/>
                <MenuItem  Header="Bảo Trì, Sửa chữa " Icon="{materialDesign:PackIcon Kind=Tools}">
                    <MenuItem Header="Đăng Xuất" Icon="{materialDesign:PackIcon Kind=DoorOpen}"/>
                </MenuItem>
            </MenuItem>
            <!-- HỆ THỐNG -->
            <MenuItem Header="Hệ Thống">
                <MenuItem Header="Đăng Xuất" Icon="{materialDesign:PackIcon Kind=DoorOpen}"/>
                <MenuItem Header="Đổi Mật Khẩu " Icon="{materialDesign:PackIcon Kind=Key}"/>
                <MenuItem Header="Quản Trị Người Dùng" Icon="{materialDesign:PackIcon Kind=AccountMultiple}"  />
                <MenuItem Header="Thay Đổi Khoa/Phòng Ban" Icon="{materialDesign:PackIcon Kind=DomainArrowRight}"/>
            </MenuItem>

        </Menu>
    </Grid>
</UserControl>
