<Window x:Class="ITAM.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ITAM.WPF"
        mc:Ignorable="d"
        xmlns:userControl="clr-namespace:ITAM.WPF.UserControls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="12"
        Style="{StaticResource MaterialDesignWindow}"
        Title="{Binding NavigationService.CurrentTitle}" Height="450" Width="800">
    <Window.InputBindings>
        <KeyBinding Key="N"
                Modifiers="Ctrl"
                Command="{Binding ToolbarViewModel.CurrentContext.AddCommand}" />

        <KeyBinding Key="E"
                Modifiers="Ctrl"
                Command="{Binding ToolbarViewModel.CurrentContext.EditCommand}" />

        <KeyBinding Key="D"
                Modifiers="Ctrl"
                Command="{Binding ToolbarViewModel.CurrentContext.DeleteCommand}" />

        <KeyBinding Key="S"
                Modifiers="Ctrl"
                Command="{Binding ToolbarViewModel.CurrentContext.SaveCommand}" />

        <KeyBinding Key="Escape"
                Command="{Binding ToolbarViewModel.CurrentContext.CancelCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <userControl:MenuBarUC DataContext="{Binding MenuBarViewModel}"></userControl:MenuBarUC>
        </Grid>
        <Grid Grid.Row="1">
            <userControl:ToolbarUC DataContext="{Binding ToolbarViewModel}"></userControl:ToolbarUC>
        </Grid>
        <Grid Grid.Row="2">
            <ContentControl Content="{Binding NavigationService.CurrentView}"/>
        </Grid>
        <Grid Grid.Row="3" Background="#5D6B99">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Foreground="AliceBlue" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"
               Text="Phím tắt: Ctrl+N=Thêm, Ctrl+E=Sửa, Ctrl+D=Xóa, Ctrl+S=Lưu, Esc=Bỏ qua"/>
            <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Margin="12,0">

                <!-- Phòng ban -->
                <TextBlock Text="{Binding CurrentPhongBanName}"
               Foreground="#B8F2C8"
               VerticalAlignment="Center"
               Margin="0,0,8,0"/>

                <!-- Tên user -->
                <TextBlock Text="{Binding CurrentUserDisplayName}"
               Foreground="#FFE69A"
               FontWeight="SemiBold"
               VerticalAlignment="Center"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
