<UserControl x:Class="ITAM.WPF.Views.Reports.BaoCaoTaiSanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="700"
             >
    <StackPanel Margin="20" MaxWidth="600" HorizontalAlignment="Left">
        <TextBlock Text="DANH SÁCH TÀI SẢN" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DatePicker Grid.Row="0" Grid.Column="0" materialDesign:HintAssist.Hint="Từ ngày"
                        SelectedDate="{Binding TuNgay}" Margin="0,0,8,16"/>
            <DatePicker Grid.Row="0" Grid.Column="1" materialDesign:HintAssist.Hint="Đến ngày"
                        SelectedDate="{Binding DenNgay}" Margin="8,0,0,16"/>

            <ComboBox Grid.Row="1" Grid.Column="0" materialDesign:HintAssist.Hint="Phòng ban"
                      ItemsSource="{Binding DsPhongBan}" DisplayMemberPath="Name"
                      SelectedValuePath="Id" SelectedValue="{Binding PhongBanId}" Margin="0,0,8,16"/>
            <ComboBox Grid.Row="1" Grid.Column="1" materialDesign:HintAssist.Hint="Vị trí"
                      ItemsSource="{Binding DsViTriTaiSan}" DisplayMemberPath="Name"
                      SelectedValuePath="Id" SelectedValue="{Binding ViTriTaiSanId}" Margin="8,0,0,16"/>

            <ComboBox Grid.Row="2" Grid.Column="0" materialDesign:HintAssist.Hint="Loại tài sản"
                      ItemsSource="{Binding DsLoaiTaiSan}" DisplayMemberPath="Name"
                      SelectedValuePath="Id" SelectedValue="{Binding LoaiTaiSanId}" Margin="0,0,8,16"/>
            <ComboBox Grid.Row="2" Grid.Column="1" materialDesign:HintAssist.Hint="Danh mục"
                      ItemsSource="{Binding DsDMTaiSan}" DisplayMemberPath="Name"
                      SelectedValuePath="Id" SelectedValue="{Binding DMTaiSanId}" Margin="8,0,0,16"/>

            <ComboBox Grid.Row="3" Grid.Column="0" materialDesign:HintAssist.Hint="Trạng thái"
                      ItemsSource="{Binding DsTrangThai}" SelectedValue="{Binding TrangThai}"
                      Margin="0,0,8,16"/>
            <TextBox Grid.Row="3" Grid.Column="1" materialDesign:HintAssist.Hint="Hãng SX"
                     Text="{Binding HangSanXuat}" Margin="8,0,0,16"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Xuất Excel" Command="{Binding XuatExcelCommand}" Width="130" Margin="0,0,8,0"/>
            <Button Content="Đặt lại" Command="{Binding DatLaiCommand}" Width="110"/>
        </StackPanel>
    </StackPanel>
</UserControl>