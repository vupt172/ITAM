<UserControl x:Class="ITAM.WPF.Views.Reports.TongHopTaiSanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bộ lọc -->
        <materialDesign:Card Grid.Column="0" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Điều kiện lọc" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <ComboBox materialDesign:HintAssist.Hint="Phòng ban" Margin="0,6"
                              ItemsSource="{Binding PhongBans}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding PhongBanId}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
                    <ComboBox materialDesign:HintAssist.Hint="Vị trí" Margin="0,6"
                              ItemsSource="{Binding ViTris}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding ViTriId}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
                    <ComboBox materialDesign:HintAssist.Hint="Loại tài sản" Margin="0,6"
                              ItemsSource="{Binding LoaiTaiSans}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding LoaiTaiSanId}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
                    <ComboBox materialDesign:HintAssist.Hint="Danh mục" Margin="0,6"
                              ItemsSource="{Binding DanhMucs}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding DanhMucId}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
                    <ComboBox materialDesign:HintAssist.Hint="Hãng sản xuất" Margin="0,6"
                              ItemsSource="{Binding HangSanXuats}"
                              SelectedItem="{Binding HangSanXuatChon}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
                    <ComboBox materialDesign:HintAssist.Hint="Trạng thái" Margin="0,6"
                              ItemsSource="{Binding TrangThais}" DisplayMemberPath="Text"
                              SelectedItem="{Binding TrangThaiChon}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

                    <Separator Margin="0,10"/>

                    <ComboBox materialDesign:HintAssist.Hint="Nhóm theo" Margin="0,6"
                              ItemsSource="{Binding NhomTheos}" DisplayMemberPath="Text"
                              SelectedItem="{Binding NhomTheoChon}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>

                    <Button Content="Xem báo cáo" Command="{Binding XemBaoCaoCommand}" Margin="0,14,0,0"/>
                    <Button Content="Excel" Command="{Binding XuatExcelCommand}" Margin="0,8,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>

        <!-- Kết quả -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="KetQuaGrid" Grid.Row="0" ItemsSource="{Binding KetQua}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <!-- Header của cột này được cập nhật trong code-behind theo TenCotNhom -->
                    <DataGridTextColumn x:Name="NhomColumn" Header="Nhóm" Binding="{Binding TenNhom}" Width="*"/>
                    <DataGridTextColumn Header="Số lượng" Width="120"
                                        Binding="{Binding SoLuong, StringFormat=N0, ConverterCulture=vi-VN}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tổng nguyên giá" Width="200"
                                        Binding="{Binding TongNguyenGia, StringFormat=N0, ConverterCulture=vi-VN}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Dòng tổng cộng -->
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tổng cộng" FontWeight="Bold" Margin="8,0"/>
                <TextBlock Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,8,0"
                           Text="{Binding TongSoLuong, StringFormat=N0, ConverterCulture=vi-VN}"/>
                <TextBlock Grid.Column="2" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,8,0"
                           Text="{Binding TongNguyenGia, StringFormat=N0, ConverterCulture=vi-VN}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
