<UserControl x:Class="ITAM.WPF.Views.Reports.SoTaiSanCoDinhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <StackPanel Margin="24" Width="320" HorizontalAlignment="Left">
        <TextBlock Text="SỔ TÀI SẢN CỐ ĐỊNH (S24-H)"
                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                   Margin="0,0,0,16"/>

        <ComboBox ItemsSource="{Binding DanhSachNam}"
                  SelectedItem="{Binding NamChon}"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                  materialDesign:HintAssist.Hint="Năm báo cáo"
                  Margin="0,0,0,24"/>

        <Button Content="Xuất Excel"
                Command="{Binding XuatExcelCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}"
                HorizontalAlignment="Left"/>

        <ProgressBar IsIndeterminate="True" Margin="0,16,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </StackPanel>
</UserControl>
