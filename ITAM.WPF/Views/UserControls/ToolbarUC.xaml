<UserControl x:Class="ITAM.WPF.UserControls.ToolbarUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ITAM.WPF.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
            TextElement.FontWeight="Regular"
            TextElement.FontSize="13"
             mc:Ignorable="d" 
              d:DesignWidth="800">

    <ToolBarTray IsLocked="True">

        <ToolBar OverflowMode="Never">
            <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Thêm"
                    Command="{Binding CurrentContext.AddCommand}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon  Style="{StaticResource ToolbarIconStyle}" Kind="ShapeSquarePlus" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource ToolbarTextStyle}" Text="Thêm" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Sửa"
                    Command ="{Binding CurrentContext.EditCommand}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon  Style="{StaticResource ToolbarIconStyle}" Kind="SquareEditOutline" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource ToolbarTextStyle}" Text="Sửa" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Xóa"
                    Command="{Binding CurrentContext.DeleteCommand}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon  Style="{StaticResource ToolbarIconStyle}" Kind="CloseBoxOutline" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource ToolbarTextStyle}" Text="Xóa" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Lưu"
                    Command="{Binding CurrentContext.SaveCommand}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon  Style="{StaticResource ToolbarIconStyle}" Kind="ContentSave" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource ToolbarTextStyle}" Text="Lưu" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Bỏ qua"
                    Command="{Binding CurrentContext.CancelCommand}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Style="{StaticResource ToolbarIconStyle}" Kind="DeleteSweepOutline" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource ToolbarTextStyle}" Text="Bỏ qua" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Làm tươi"
         Command="{Binding CurrentContext.RefreshCommand}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Style="{StaticResource ToolbarIconStyle}" Kind="Refresh" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource ToolbarTextStyle}" Text="Refresh" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Tìm kiếm"
                    Command="{Binding CurrentContext.SearchCommand}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Style="{StaticResource ToolbarIconStyle}" Kind="Magnify" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource ToolbarTextStyle}" Text="Tìm kiếm" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Style="{StaticResource ToolbarButtonStyle}" ToolTip="Đóng"
         Command="{Binding CurrentContext.CloseCommand}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Style="{StaticResource ToolbarIconStyle}" Kind="ExitToApp" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource ToolbarTextStyle}" Text="Đóng" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ToolBar>

    </ToolBarTray>
</UserControl>
