<UserControl x:Class="ITAM.WPF.Views.UserControls.MultiColumnSearchComboBox"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid>

        <!-- ================================================= -->
        <!-- Ô nhập -->
        <!-- ================================================= -->

        <TextBox x:Name="PART_TextBox"
                 Height="32"
                 VerticalContentAlignment="Bottom"
                 Padding="0 2"
                 Text="{Binding SearchText, ElementName=root, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="{Binding Hint, ElementName=root}"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />


        <!-- ================================================= -->
        <!-- Nút mũi tên -->
        <!-- ================================================= -->

        <Button x:Name="PART_DropDownButton"
        Width="18"
        Height="18"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Margin="0,4,0,0" Padding="0"
        Click="DropDownButton_Click"
        Background="Transparent"
        BorderThickness="0"
        Focusable="False">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#10000000"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#20000000"/>
                        </Trigger>
                    </Style.Triggers>

                </Style>
            </Button.Style>
            <materialDesign:PackIcon Kind="MenuDown" Width="18" Height="18" Margin="0,0,-10,0"/>
        </Button>
   



        <!-- ================================================= -->
        <!-- Popup -->
        <!-- ================================================= -->

        <Popup x:Name="PART_Popup"
               PlacementTarget="{Binding ElementName=root}"
               Placement="Bottom"
               HorizontalOffset="0"
               VerticalOffset="2"
               AllowsTransparency="True"
               StaysOpen="False"
               IsOpen="{Binding IsDropDownOpen, ElementName=root, Mode=TwoWay}">

            <Border
                Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                CornerRadius="2"
                SnapsToDevicePixels="True">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"/>
                </Border.Effect>

                <DataGrid x:Name="PART_DataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeight="32"
                          ColumnHeaderHeight="34"
                          MaxHeight="300"
                          MinWidth="500"
                          ItemsSource="{Binding View, ElementName=root}"
                          KeyboardNavigation.TabNavigation="None"/>
            </Border>
        </Popup>
    </Grid>

</UserControl>

