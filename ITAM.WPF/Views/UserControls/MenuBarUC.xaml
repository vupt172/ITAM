<UserControl x:Class="ITAM.WPF.UserControls.MenuBarUC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ITAM.WPF.UserControls"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="13"
             d:DesignWidth="800">
    <Grid Background="{StaticResource MenuBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Logo -->
        <StackPanel Grid.Column="0"  Orientation="Horizontal" VerticalAlignment="Center">

        </StackPanel>
        <Menu Grid.Column="1">
            <!-- DASHBOARD -->
            <MenuItem Header="Dashboard">
                <MenuItem Header="View Dashboard"  Icon="{materialDesign:PackIcon Kind=ViewDashboard}" Visibility="{Binding HasFeatureDashboard, Converter={StaticResource BooleanToVisibilityConverter}}" 
                          Command="{Binding NavigateDashboardCommand}" />
            </MenuItem>
            <!-- DANH MỤC -->
            <MenuItem Header="Danh Mục">
                <MenuItem  Header="Hệ Thống Danh Mục" Icon="{materialDesign:PackIcon Kind=FormatListBulleted}" Visibility="{Binding HasFeatureHeThongDM, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Command="{Binding NavigatHeThongDMCommand}"/>
            </MenuItem>
            <!-- Kho -->
            <MenuItem Header="Quản Lý Kho">
                <MenuItem Header="Nhập Tài Sản Từ NCC"
                          Command="{Binding NavigateLoNhapCommand}"/>
            </MenuItem>
            <!-- TÀI SẢN -->
            <MenuItem Header="Tài Sản">
                <MenuItem Header="Danh Sách Tài Sản Định Danh" Icon="{materialDesign:PackIcon Kind=FormatListBulletedSquare}"
          Command="{Binding NavigateTaiSanDinhDanhCommand}"/>
                <MenuItem Header="Điều Chuyển Tài Sản" Icon="{materialDesign:PackIcon Kind=SwapHorizontal}"
          Visibility="{Binding HasFeatureDieuChuyen, Converter={StaticResource BooleanToVisibilityConverter}}"
          Command="{Binding NavigateDieuChuyenCommand}"/>
                <MenuItem  Header="Bảo Trì, Sửa chữa " Icon="{materialDesign:PackIcon Kind=Tools}">
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Vật Tư">
                <MenuItem Header="Danh Sách Vật Tư" Icon="{materialDesign:PackIcon Kind=PackageVariant}"
          Command="{Binding NavigateVatTuCommand}"/>
            </MenuItem>

            <!-- HỆ THỐNG -->
            <MenuItem Header="Hệ Thống">
                <MenuItem Header="Đăng Xuất" Icon="{materialDesign:PackIcon Kind=DoorOpen}"
                          Command="{Binding LogoutCommand}"/>
                <MenuItem Header="Đổi Mật Khẩu " Icon="{materialDesign:PackIcon Kind=Key}"/>

                <Separator/>
                <MenuItem Header="Quản Trị Người Dùng" Icon="{materialDesign:PackIcon Kind=AccountMultiple}" Visibility="{Binding HasFeatureUserManagement, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Command="{Binding NavigateUserManagementCommand}"/>
                <MenuItem Header="Quản Trị Vai Trò" Icon="{materialDesign:PackIcon Kind=ShieldAccount}" Visibility="{Binding HasFeatureRoleManagement, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Command="{Binding NavigateRoleManagementCommand}"/>
                <MenuItem Header="Tham Số Người Dùng" Icon="{materialDesign:PackIcon Kind=AccountCog}"
                          Command="{Binding NavigateThamSoNguoiDungCommand}"/>
                <Separator/>
                <MenuItem Header="Thay Đổi Khoa/Phòng Ban" Icon="{materialDesign:PackIcon Kind=DomainArrowRight}"
              Command="{Binding ChangePhongBanCommand}"/>
            </MenuItem>
        </Menu>
    </Grid>
</UserControl>
