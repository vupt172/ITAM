<Window x:Class="ITAM.WPF.Views.VatTuEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Sửa Vật Tư"
        Height="400" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBox Text="{Binding TenHangHoa, Mode=OneWay}" IsReadOnly="True"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Hàng hóa" Margin="0,0,0,16"/>
            <TextBox Text="{Binding SoLuongTon, Mode=OneWay}" IsReadOnly="True"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Số lượng tồn" Margin="0,0,0,16"/>
            <TextBox Text="{Binding TenViTri, Mode=OneWay}" IsReadOnly="True"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Vị trí hiện tại" Margin="0,0,0,16"/>

            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Tên vật tư" Margin="0,0,0,16"/>
            <TextBox Text="{Binding DonViTinh, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Đơn vị tính" Margin="0,0,0,16"/>
            <TextBox Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Ghi Chú"/>
   
            <TextBlock Text="Đang tải dữ liệu..."
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Foreground="Gray" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Lưu" Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
            <Button Content="Hủy" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>
    </Grid>
</Window>