<Window x:Class="ITAM.WPF.Views.LoNhapSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Tìm kiếm Phiếu Nhập"
        Height="560" Width="820"
        WindowStartupLocation="CenterOwner">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBox Width="160" Text="{Binding SoLo, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Số phiếu"/>
            <DatePicker Width="140" Margin="8,0" SelectedDate="{Binding TuNgay}"
                        materialDesign:HintAssist.Hint="Từ ngày"
                          Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
            <DatePicker Width="140" SelectedDate="{Binding DenNgay}"
                        materialDesign:HintAssist.Hint="Đến ngày"
                          Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
            <ComboBox Width="140" Margin="8,0" ItemsSource="{Binding TrangThaiOptions}"
                      SelectedItem="{Binding SelectedTrangThai}"
                      materialDesign:HintAssist.Hint="Trạng thái"
                        Style="{StaticResource MaterialDesignFloatingHintComboBox}"/>
            <Button Content="Tìm" Command="{Binding SearchCommand}" Margin="8,0,0,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>

        <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40"
                  ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoLo}" Width="130"/>
                <DataGridTextColumn Header="Ngày nhập" Binding="{Binding NgayNhap, StringFormat=d}" Width="110"/>
                <DataGridTextColumn Header="Nhà cung cấp" Binding="{Binding TenNhaCungCap}" Width="*"/>
                <DataGridTextColumn Header="Người lập phiếu" Binding="{Binding TenNguoiLapPhieu}" Width="160"/>
                <DataGridTemplateColumn Header="Trạng thái" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
              Background="{Binding TrangThai, Converter={StaticResource TrangThaiLoNhapToBrushConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{Binding TrangThai, Converter={StaticResource TrangThaiLoNhapToIconKindConverter}}"
                                    Foreground="White" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TrangThai}" Width="100"
                     Foreground="White" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ChonCommand}"/>
            </DataGrid.InputBindings>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Chọn" Command="{Binding ChonCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
            <Button Content="Đóng" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>
    </Grid>
</Window>