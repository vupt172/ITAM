<UserControl x:Class="ITAM.WPF.Views.VatTuListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="16">
        <materialDesign:Card Padding="12">
            <DataGrid AutoGenerateColumns="False" IsReadOnly="True"
                ItemsSource="{Binding DanhSach}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Hàng hóa" Binding="{Binding MaHangHoa}" Width="150"/>
                    <DataGridTextColumn Header="Tên vật tư" Binding="{Binding Name}" Width="500"/>
                    <DataGridTextColumn Header="ĐVT" Binding="{Binding DonViTinh}" Width="80"/>
                    <DataGridTextColumn Header="SL tồn" Binding="{Binding SoLuongTon}" Width="80"/>
                    <DataGridTextColumn Header="Vị trí" Binding="{Binding TenViTri}" Width="150"/>
                    <DataGridTextColumn Header="Ghi Chú" Binding="{Binding GhiChu}" Width="300"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>