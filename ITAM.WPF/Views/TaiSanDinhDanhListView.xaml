<UserControl x:Class="ITAM.WPF.Views.TaiSanDinhDanhListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="3*" MaxHeight="250"/>
        </Grid.RowDefinitions>

        <!-- Hàng 1: Filter trái (Left) + Search/DataGrid phải (Right) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: FILTER -->
            <materialDesign:Card Grid.Column="0" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,8" Padding="6">
                            <StackPanel>
                                <TextBlock Text="Vị Trí Tài Sản" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding ViTriFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Value}" IsChecked="{Binding IsChecked}" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,8" Padding="6">
                            <StackPanel>
                                <TextBlock Text="Loại Tài Sản" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding LoaiTaiSanFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Value}" IsChecked="{Binding IsChecked}" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                CornerRadius="4" Padding="6">
                            <StackPanel>
                                <TextBlock Text="Trạng Thái" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding TrangThaiFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,2">
                                                <TextBlock Text="{Binding Value}"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
        CornerRadius="4" Margin="0,0,0,8" Padding="6">
                            <StackPanel>
                                <TextBlock Text="Danh Mục Tài Sản" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding DanhMucFilters}"
                  SelectedItem="{Binding SelectedDanhMuc}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>

            <!-- RIGHT: SEARCH + DATAGRID -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ô tìm kiếm chung -->
                    <Grid Grid.Column="0">
                        <TextBox materialDesign:HintAssist.Hint="Tìm theo Mã, Tên, Serial, Mã Hàng Hóa, Số PNCT..."
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 Padding="30,0,0,0"/>
                        <materialDesign:PackIcon Kind="Magnify"
                                  Width="20" Height="20"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Opacity="0.56"
                                  IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Ô quét QRCode -->
                    <Grid Grid.Column="2">
                        <TextBox x:Name="TxtQuetQr"
                 materialDesign:HintAssist.Hint="Quét mã QRCode"
                 Text="{Binding MaQuet, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                 Padding="30,0,0,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding QuetMaCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <materialDesign:PackIcon Kind="Qrcode"
                                  Width="20" Height="20"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Opacity="0.56"
                                  IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <materialDesign:Card Grid.Row="2" Padding="8">
                    <DataGrid ItemsSource="{Binding DanhSach}" SelectedItem="{Binding SelectedItem}">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
             
                            <DataGridTextColumn Header="Mã tài sản" Binding="{Binding Code}" Width="130"/>
                            <DataGridTextColumn Header="Tên tài sản" Binding="{Binding Name}" Width="400"/>
                            <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="120"/>
                            <DataGridTextColumn Header="Mã Hàng hóa" Binding="{Binding MaHangHoa}" Width="120"/>
                            <DataGridTextColumn Header="Loại TS" Binding="{Binding TenLoaiTaiSan}" Width="110"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiTaiSan}" Width="100"/>
                            <DataGridTextColumn Header="Vị trí" Binding="{Binding TenViTri}" Width="120"/>
                            <DataGridTextColumn Header="Năm SD" Binding="{Binding NamSuDung}" Width="70"/>
                            <DataGridTextColumn Header="Số PNCT" Binding="{Binding SoLoNhapChiTiet}" Width="130"/>
                            <DataGridTextColumn Header="Giá nhập" Binding="{Binding GiaNhap, StringFormat=N0}" Width="100"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="300"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Height="6" Background="Transparent"/>

        <!-- Hàng 2 (Bottom): Tabs chức năng tiện ích -->
        <materialDesign:Card Grid.Row="2" Padding="0">
            <TabControl Style="{StaticResource CompactTabControl}" >
                <TabItem Header="Thông Tin Chi Tiết">
                    <Border BorderBrush="#D0D5DD" BorderThickness="2" Background="#FAF3DD">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ==================== HÀNG 1 ==================== -->
                            <Grid Grid.Row="0" Margin="0">
                                <Grid.ColumnDefinitions>
                                    <!-- Hình ảnh -->
                                    <ColumnDefinition Width="100"/>
                                    <!-- Thông tin -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- HÌNH ẢNH -->
                                <Border Grid.Column="0"
                        Width="100"
                        Height="100"
                        HorizontalAlignment="Left"
                        BorderBrush="#D0D5DD"
                        BorderThickness="1"
                        Background="White">

                                    <Image Source="{Binding SelectedItem.ImagePath}"
                           Stretch="Uniform"
                           Margin="6"/>
                                </Border>


                                <!-- THÔNG TIN CƠ BẢN -->
                                <Grid Grid.Column="1" Margin="6,0,0,0">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>


                                    <!-- Mã | Serial | Năm sử dụng -->
                                    <Grid Grid.Row="0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                    Margin="0,0,16,0">

                                            <TextBlock Text="MÃ TÀI SẢN"
                                       FontSize="11"
                                       Foreground="Gray"/>

                                            <TextBlock Text="{Binding SelectedItem.Code}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#1565C0"/>
                                        </StackPanel>


                                        <StackPanel Grid.Column="1"
                                    Margin="0,0,16,0">

                                            <TextBlock Text="SERIAL"
                                       FontSize="11"
                                       Foreground="Gray"/>

                                            <TextBlock Text="{Binding SelectedItem.Serial}"
                                       FontSize="13"/>
                                        </StackPanel>


                                        <StackPanel Grid.Column="2">

                                            <TextBlock Text="NĂM SỬ DỤNG"
                                       FontSize="11"
                                       Foreground="Gray"/>

                                            <TextBlock Text="{Binding SelectedItem.NamSuDung}"
                                       FontSize="13"/>
                                        </StackPanel>

                                    </Grid>
                                    <!-- Tên tài sản -->
                                    <StackPanel Grid.Row="1" Margin="0,6,0,0">

                                        <TextBlock Text="TÊN TÀI SẢN"
                                   FontSize="11"
                                   Foreground="Gray"/>

                                        <TextBlock Text="{Binding SelectedItem.Name}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <!-- Vị trí | Loại | Trạng thái -->
                                    <Grid Grid.Row="2" Margin="0,6,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>


                                        <StackPanel Grid.Column="0"
                                    Margin="0,0,16,0">

                                            <TextBlock Text="VỊ TRÍ"
                                       FontSize="11"
                                       Foreground="Gray"/>

                                            <TextBlock Text="{Binding SelectedItem.TenViTri}"
                                       FontSize="13"/>
                                        </StackPanel>


                                        <StackPanel Grid.Column="1"
                                    Margin="0,0,16,0">

                                            <TextBlock Text="LOẠI TÀI SẢN"
                                       FontSize="11"
                                       Foreground="Gray"/>

                                            <TextBlock Text="{Binding SelectedItem.TenLoaiTaiSan}"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                                        </StackPanel>


                                        <StackPanel Grid.Column="2">

                                            <TextBlock Text="TRẠNG THÁI"
                                       FontSize="11"
                                       Foreground="Gray"/>

                                            <TextBlock Text="{Binding SelectedItem.TrangThaiTaiSan}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#2E7D32"/>
                                        </StackPanel>

                                    </Grid>
                                </Grid>

                            </Grid>
                            <!-- ==================== HÀNG 2 ==================== -->
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.Column="0"
                            Margin="0,0,16,0">

                                    <TextBlock Text="MÃ HÀNG HÓA"
                               FontSize="11"
                               Foreground="Gray"/>

                                    <TextBlock Text="{Binding SelectedItem.MaHangHoa}"
                               FontSize="13"/>
                                </StackPanel>


                                <StackPanel Grid.Column="1"
                            Margin="0,0,16,0">

                                    <TextBlock Text="GIÁ NHẬP"
                               FontSize="11"
                               Foreground="Gray"/>

                                    <TextBlock Text="{Binding SelectedItem.GiaNhap, StringFormat=N0}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#B71C1C"/>
                                </StackPanel>


                                <StackPanel Grid.Column="2">

                                    <TextBlock Text="SỐ PHIẾU NHẬP CHI TIẾT"
                               FontSize="11"
                               Foreground="Gray"/>

                                    <TextBlock Text="{Binding SelectedItem.SoLoNhapChiTiet}"
                               FontSize="13"/>
                                </StackPanel>

                            </Grid>
                            <!-- ==================== HÀNG 3 ==================== -->
                            <StackPanel Grid.Row="2" Margin="0,6,0,0">
                                <TextBlock Text="GHI CHÚ"
                           FontSize="11"
                           Foreground="Gray"/>
                                <TextBlock Text="{Binding SelectedItem.GhiChu}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           FontStyle="Italic"/>
                            </StackPanel>
                        </Grid>

                    </Border>
                </TabItem>

                <TabItem Header="Lịch Sử Điều Chuyển">
                    <Grid>
                        <TextBlock Text="Đang xây dựng" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="16" Opacity="0.6"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Lịch Sử Sửa Chữa">
                    <Grid>
                        <TextBlock Text="Đang xây dựng" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="16" Opacity="0.6"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </materialDesign:Card>
    </Grid>
</UserControl>