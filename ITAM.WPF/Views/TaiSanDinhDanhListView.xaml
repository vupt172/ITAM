<UserControl x:Class="ITAM.WPF.Views.TaiSanDinhDanhListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="16">
        <materialDesign:Card Padding="12">
            <DataGrid CanUserResizeRows="true" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All"
                ItemsSource="{Binding DanhSach}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã tài sản" Binding="{Binding Code}" Width="130"/>
                    <DataGridTextColumn Header="Tên tài sản" Binding="{Binding Name}" Width="500"/>
                    <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="130"/>
                    <DataGridTextColumn Header="Mã Hàng hóa" Binding="{Binding MaHangHoa}" Width="150"/>
                    <DataGridTextColumn Header="Loại TS" Binding="{Binding TenLoaiTaiSan}" Width="120"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThaiTaiSan}" Width="120"/>
                    <DataGridTextColumn Header="Vị trí" Binding="{Binding TenViTri}" Width="150"/>
                    <DataGridTextColumn Header="Năm SD" Binding="{Binding NamSuDung}" Width="80"/>
                    <DataGridTextColumn Header="Số PNCT" Binding="{Binding SoLoNhapChiTiet}" Width="150"/>
                    <DataGridTextColumn Header="Giá nhập" Binding="{Binding GiaNhap, StringFormat=N0}" Width="110"/>
                    <DataGridTextColumn Header="Ghi Chú" Binding="{Binding GhiChu}" Width="300"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>