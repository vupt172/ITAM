<Window x:Class="ITAM.WPF.Views.Dialogs.PhieuThanhLySearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Tìm Phiếu Thanh Lý" Width="880" Height="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="160" Margin="0,0,12,0"
                         Text="{Binding SoPhieu, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Số phiếu">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding TimKiemCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <DatePicker Width="140" Margin="0,0,12,0" SelectedDate="{Binding TuNgay}"
                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                            materialDesign:HintAssist.Hint="Từ ngày"/>
                <DatePicker Width="140" Margin="0,0,12,0" SelectedDate="{Binding DenNgay}"
                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                            materialDesign:HintAssist.Hint="Đến ngày"/>

                <ComboBox Width="140" Margin="0,0,16,0"
                          ItemsSource="{Binding TrangThaiOptions}" SelectedItem="{Binding TrangThaiChon}"
                          DisplayMemberPath="Ten"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          materialDesign:HintAssist.Hint="Trạng thái"/>

                <Button Content="Tìm kiếm" Command="{Binding TimKiemCommand}" Margin="0,0,8,0"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </materialDesign:Card>

        <DataGrid Grid.Row="1" x:Name="DgKetQua" RowHeight="34"
                  ItemsSource="{Binding KetQua}" SelectedItem="{Binding DongChon}"
                  MouseDoubleClick="DgKetQua_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Số phiếu" Binding="{Binding SoPhieu}" Width="140"/>
                <DataGridTextColumn Header="Ngày tạo" Binding="{Binding NgayTao, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                <DataGridTextColumn Header="Lý do" Binding="{Binding LyDo}" Width="*"/>
                <DataGridTextColumn Header="Người tạo" Binding="{Binding TenNguoiTao}" Width="170"/>
                <DataGridTemplateColumn Header="Trạng thái" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
                                    Background="{Binding TrangThai, Converter={StaticResource TrangThaiDieuChuyenToBrushConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{Binding TrangThai, Converter={StaticResource TrangThaiDieuChuyenToIconKindConverter}}"
                                                             Foreground="White" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TrangThai}" Width="100"
                                               Foreground="White" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Chọn" Command="{Binding ChonCommand}" Margin="0,0,8,0" Width="90"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="Đóng" IsCancel="True" Width="90"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>
    </Grid>
</Window>