<Window x:Class="ITAM.WPF.Views.TaiSanDinhDanhEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Sửa Tài Sản Định Danh"
        Width="700" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== NHÓM 1: THÔNG TIN HIỆN TẠI (CHỈ ĐỌC) ===== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="THÔNG TIN HIỆN TẠI"
                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                       Margin="0,0,0,8"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0"
                         Text="{Binding Code, Mode=OneWay}" IsReadOnly="True"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Mã tài sản" Margin="0,0,0,12"/>
                <TextBox Grid.Row="0" Grid.Column="2"
                         Text="{Binding TrangThai, Mode=OneWay}" IsReadOnly="True"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Trạng thái" Margin="0,0,0,12"/>

                <TextBox Grid.Row="1" Grid.Column="0"
                         Text="{Binding TenHangHoa, Mode=OneWay}" IsReadOnly="True"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Hàng hóa" Margin="0,0,0,12"/>
                <TextBox Grid.Row="1" Grid.Column="2"
                         Text="{Binding TenLoaiTaiSan, Mode=OneWay}" IsReadOnly="True"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Loại tài sản" Margin="0,0,0,12"/>

                <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                         Text="{Binding TenViTri, Mode=OneWay}" IsReadOnly="True"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Vị trí hiện tại"/>
            </Grid>
        </StackPanel>

        <!-- ===== NHÓM 2: THÔNG TIN CHỈNH SỬA ===== -->
        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <Separator Margin="0,0,0,12"/>
            <TextBlock Text="THÔNG TIN CHỈNH SỬA"
                       Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                       Margin="0,0,0,8"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Tên tài sản" Margin="0,0,0,12"/>

                <TextBox Grid.Row="1" Grid.Column="0"
                         Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Serial" Margin="0,0,0,12"/>
                <TextBox Grid.Row="1" Grid.Column="2"
                         Text="{Binding NamSuDung, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Năm sử dụng" Margin="0,0,0,12"/>

                <TextBox Grid.Row="2" Grid.Column="0"
                         Text="{Binding SoHieuTSCD, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Số hiệu TSCĐ" Margin="0,0,0,12"/>

                <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                         Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Ghi chú"/>
            </Grid>

            <TextBlock Text="Đang tải dữ liệu..."
                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Foreground="Gray" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ===== NÚT ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Lưu" Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
            <Button Content="Hủy" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>
    </Grid>
</Window>