<!-- ITAM.WPF/Views/DashboardView.xaml -->
<UserControl x:Class="ITAM.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ChartCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="UniformCornerRadius" Value="10" />
        </Style>
        <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 0: header -->
                <RowDefinition Height="Auto" />
                <!-- 1: KPI -->
                <RowDefinition Height="Auto" />
                <!-- 2: phòng ban | danh mục | doughnut | hoạt động -->
                <RowDefinition Height="Auto" />
                <!-- 3: nhập theo tháng | so sánh | (doughnut) | (hoạt động) -->
                <RowDefinition Height="Auto" />
                <!-- 4: top giá trị (2 cột) | giá trị theo PB | (hoạt động) -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ============ Header ============ -->
            <Grid Grid.Row="0" Grid.ColumnSpan="4" Margin="6,0,6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Tổng quan tình hình tài sản ITAM" Opacity="0.65" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker Width="130" SelectedDate="{Binding TuNgay}"
                                materialDesign:HintAssist.Hint="Từ ngày"
                                Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                    <materialDesign:PackIcon Kind="ArrowRight" VerticalAlignment="Center" Margin="8,0" />
                    <DatePicker Width="130" SelectedDate="{Binding DenNgay}"
                                materialDesign:HintAssist.Hint="Đến ngày"
                                Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                    <Button Content="Làm mới" Margin="16,0,0,0" Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>
                <ProgressBar Grid.ColumnSpan="2" VerticalAlignment="Bottom" IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- ============ 6 KPI card ============ -->
            <ItemsControl Grid.Row="1" Grid.ColumnSpan="4" ItemsSource="{Binding Kpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <materialDesign:Card Margin="6" Padding="14" UniformCornerRadius="10"
                                             Background="{Binding Tint}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="24" Background="{Binding Accent}"
                                        Opacity="0.9" VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="{Binding Icon}" Width="26" Height="26"
                                                             Foreground="White" HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="12" Opacity="0.75" />
                                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="Bold" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding Trend}" Foreground="{Binding TrendBrush}"
                                               FontSize="11" TextWrapping="Wrap" MinHeight="16" />
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ Row 2 ============ -->
            <materialDesign:Card Grid.Row="2" Grid.Column="0" Height="300" Style="{StaticResource ChartCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tài sản theo phòng ban" Style="{StaticResource ChartTitleStyle}" />
                    <lvc:CartesianChart Series="{Binding PhongBanSeries}" YAxes="{Binding PhongBanYAxes}" />
                </DockPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Grid.Column="1" Height="300" Style="{StaticResource ChartCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tài sản theo danh mục" Style="{StaticResource ChartTitleStyle}" />
                    <lvc:CartesianChart Series="{Binding DanhMucSeries}" XAxes="{Binding DanhMucXAxes}" />
                </DockPanel>
            </materialDesign:Card>

            <!-- Doughnut (cao 2 hàng): biểu đồ + tổng ở giữa + legend % -->
            <materialDesign:Card Grid.Row="2" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource ChartCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="240" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Cơ cấu tài sản theo loại" Style="{StaticResource ChartTitleStyle}" />
                    <Grid Grid.Row="1">
                        <lvc:PieChart Series="{Binding LoaiSeries}" LegendPosition="Hidden" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="{Binding LoaiTongText}" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Tổng" Opacity="0.65" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding LoaiLegend}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Percent}" Opacity="0.75" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </materialDesign:Card>

            <!-- Hoạt động gần đây (cao 3 hàng) -->
            <materialDesign:Card Grid.Row="2" Grid.Column="3" Grid.RowSpan="3" Style="{StaticResource ChartCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Hoạt động gần đây" Style="{StaticResource ChartTitleStyle}" />
                    <ItemsControl ItemsSource="{Binding HoatDong}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{Binding Accent}"
                                            VerticalAlignment="Top">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" Foreground="White"
                                                                 Width="20" Height="20" HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TimeAgo}" FontSize="10" Opacity="0.5" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </materialDesign:Card>

            <!-- ============ Row 3 ============ -->
            <materialDesign:Card Grid.Row="3" Grid.Column="0" Height="300" Style="{StaticResource ChartCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Nhập tài sản theo tháng" Style="{StaticResource ChartTitleStyle}" />
                    <lvc:CartesianChart Series="{Binding NhapThangSeries}" XAxes="{Binding ThangXAxes}"
                                        YAxes="{Binding NhapThangYAxes}" LegendPosition="Top" />
                </DockPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="3" Grid.Column="1" Height="300" Style="{StaticResource ChartCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="So sánh nhập - điều chuyển - thanh lý" Style="{StaticResource ChartTitleStyle}" />
                    <lvc:CartesianChart Series="{Binding SoSanhSeries}" XAxes="{Binding ThangXAxes}"
                                        LegendPosition="Top" />
                </DockPanel>
            </materialDesign:Card>

            <!-- ============ Row 4 ============ -->
            <materialDesign:Card Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ChartCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tài sản có giá trị lớn nhất" Style="{StaticResource ChartTitleStyle}" />
                    <DataGrid ItemsSource="{Binding TopGiaTri}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              VerticalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="Auto" />
                            <DataGridTextColumn Header="Mã tài sản" Binding="{Binding Ma}" Width="Auto" />
                            <DataGridTextColumn Header="Tên tài sản" Binding="{Binding Ten}" Width="*" />
                            <DataGridTextColumn Header="Danh mục" Binding="{Binding DanhMuc}" Width="Auto" />
                            <DataGridTextColumn Header="Phòng ban" Binding="{Binding PhongBan}" Width="Auto" />
                            <DataGridTextColumn Header="Vị trí" Binding="{Binding ViTri}" Width="Auto" />
                            <DataGridTextColumn Header="Giá trị (VNĐ)" Binding="{Binding GiaTri}" Width="Auto">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Trạng thái" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding TrangThaiBrush}" />
                                            <TextBlock Text="{Binding TrangThai}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="4" Grid.Column="2" Height="280" Style="{StaticResource ChartCardStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tổng giá trị tài sản theo phòng ban (triệu đồng)" Style="{StaticResource ChartTitleStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <lvc:CartesianChart Series="{Binding GiaTriPbSeries}" YAxes="{Binding GiaTriPbYAxes}" />
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</UserControl>
